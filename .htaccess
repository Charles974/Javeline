Options -Indexes
# index.php sert de page par defaut quand l'URL vise le dossier lui-meme
# (ex. http://localhost/Javeline/) : la regle de reecriture ne s'applique
# pas aux dossiers existants (condition !-d), mod_dir prend alors le relais.
DirectoryIndex index.php
RewriteEngine On

# Pas de RewriteBase code en dur : Apache resout index.php relativement au
# dossier du .htaccess, ce qui fonctionne a la racine comme en sous-dossier.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,END]
